# DATABASE CONFIGURATION
USER_DB_URL=jdbc:postgresql://localhost:5432/reallive_user
USER_DB_USERNAME=user_service
USER_DB_PASSWORD=local_user_password

# REDIS CONFIGURATION
# Must match REDIS_PASSWORD used by Docker Compose.
REDIS_PASSWORD=local_redis_password
# JWT CONFIGURATION
JWT_SIGNER_KEY=your_jwt_signer_key_base64_secret_here

# OTP CONFIGURATION
OTP_HMAC_KEY=your_otp_hmac_secret_key_here

# CLOUDFLARE R2 CONFIGURATION
BUCKET_NAME=reallive-avatars
PUBLIC_BASE_URL=https://pub-your_bucket_id.r2.dev
R2_ENDPOINT=https://your_account_id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
