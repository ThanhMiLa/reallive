# DATABASE CONFIGURATION
CHANNEL_DB_URL=jdbc:postgresql://localhost:5433/reallive_channel
CHANNEL_DB_USERNAME=channel_service
CHANNEL_DB_PASSWORD=local_channel_password

# REDIS CONFIGURATION
# Must match REDIS_PASSWORD used by Docker Compose.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=local_redis_password
REDIS_DATABASE=0

ACCESS_TOKEN_COOKIE_NAME=access_token

# CLOUDFLARE R2 CONFIGURATION
BUCKET_NAME=reallive-avatars
PUBLIC_BASE_URL=https://pub-your_bucket_id.r2.dev
R2_ENDPOINT=https://your_account_id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
