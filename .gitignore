# Java / Maven build output
target/
*.class
!**/src/main/**/target/
!**/src/test/**/target/

# Node.js / React / Vite / NestJS
node_modules/
dist/
dist-ssr/
build/
.vite/
.cache/
.npm/
.pnpm-store/
*.tsbuildinfo
!**/src/main/**/build/
!**/src/test/**/build/

# Test coverage and reports
coverage/
.nyc_output/

# Local environment files (keep templates)
.local/streaming/
__pycache__/
*.pyc
.env
.env.*
!.env.example
!.env.*.example
!.env.sample
!.env.template
*.local

# Logs and runtime files
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
pids/
*.pid
*.pid.lock
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# IDEs and editors
.idea/
*.iml
*.ipr
*.iws
.vscode/*
!.vscode/extensions.json
.classpath
.project
.settings/
.factorypath
.apt_generated/
.springBeans
.sts4-cache/
*.sublime-workspace
*.swp
*.swo
*~

# Operating system files
.DS_Store
._*
Thumbs.db
Desktop.ini

# Temporary files
.tmp/
.temp/
*.tmp
*.temp
