BACKEND_BIND_ADDRESS=127.0.0.1
STREAM_SERVICE_PORT=8082

STREAM_DB_URL=jdbc:postgresql://localhost:5434/reallive_stream
STREAM_DB_USERNAME=stream_service
STREAM_DB_PASSWORD=local_stream_password

# Use the same Redis instance, database and credentials as User Service and Gateway.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=local_redis_password
REDIS_DATABASE=0
REDIS_CONNECT_TIMEOUT=2s
REDIS_TIMEOUT=2s

KAFKA_BOOTSTRAP_SERVERS=localhost:9092

ACCESS_TOKEN_COOKIE_NAME=access_token
USER_SERVICE_BASE_URL=http://localhost:8080/user
CHANNEL_SERVICE_BASE_URL=http://localhost:8081/channel

# STREAMING MEDIA (required by Stream Service; keep real keys outside Git)
# Base64 of DER PKCS#8 private key and DER X.509 public key, without PEM headers; stable across restarts.
# See stream-service/README.md for conversion from the local PEM files.
STREAM_MEDIA_PRIVATE_KEY_BASE64=
STREAM_MEDIA_PUBLIC_KEY_BASE64=
STREAM_MEDIA_KEY_ID=stream-rs256-v1
STREAM_MEDIA_ISSUER=reallive-stream
STREAM_MEDIA_AUDIENCE=reallive-media
STREAM_PUBLISH_TOKEN_TTL=8h
STREAM_READ_TOKEN_TTL=5m
STREAM_CONTROL_TOKEN_TTL=5m
STREAM_RTMP_PUBLIC_URL=rtmp://localhost:1935/live
STREAM_HLS_PUBLIC_BASE_URL=http://localhost:8898
STREAM_RECONNECT_GRACE=60s
