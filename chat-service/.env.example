PORT=3001
BACKEND_BIND_ADDRESS=127.0.0.1
MONGODB_URI=mongodb://chat_service:local_chat_password@127.0.0.1:27017/reallive_chat?authSource=reallive_chat&replicaSet=rs0
# Use the same signing key and Redis database as Gateway/User Service.
JWT_SIGNER_KEY=
JWT_ISSUER=reallive.com
ACCESS_TOKEN_COOKIE_NAME=access_token
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DATABASE=0
REDIS_USERNAME=
REDIS_PASSWORD=
AUTH_ALLOWED_ORIGINS=http://localhost:5173
STREAM_SERVICE_URL=http://127.0.0.1:8082/stream
CHANNEL_SERVICE_URL=http://127.0.0.1:8081/channel
USER_SERVICE_URL=http://127.0.0.1:8080/user
