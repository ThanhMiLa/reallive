PAYMENT_DB_URL=jdbc:postgresql://localhost:5435/reallive_payment
PAYMENT_DB_USERNAME=payment_service
PAYMENT_DB_PASSWORD=local_payment_password

# REDIS CONFIGURATION
# Must match REDIS_PASSWORD used by Docker Compose.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=local_redis_password
REDIS_DATABASE=0

ACCESS_TOKEN_COOKIE_NAME=access_token
STREAM_SERVICE_BASE_URL=http://localhost:8082/stream
USER_SERVICE_BASE_URL=http://localhost:8080/user

# VNPAY PAY 2.1.0 Sandbox credentials from the Merchant Portal.
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_API_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
VNPAY_RETURN_URL=http://localhost:5173/payment/vnpay-return
VNPAY_EXPIRE_MINUTES=15
VNPAY_RECONCILE_ENABLED=true
VNPAY_RECONCILE_FIXED_DELAY_MS=300000
VNPAY_RECONCILE_MIN_AGE_MINUTES=3
VNPAY_RECONCILE_EXPIRE_BUFFER_MINUTES=10
VNPAY_RECONCILE_BATCH_SIZE=50
VNPAY_RECONCILE_HTTP_TIMEOUT_MS=5000
VNPAY_QUERY_IP_ADDRESS=127.0.0.1
