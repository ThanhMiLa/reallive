# Runtime
NODE_ENV=development
PORT=8090

# Internal API authentication. Replace with a random value of at least 32 characters.
# Never commit the real value.
MEDIA_WORKER_INTERNAL_TOKEN=replace-with-a-random-internal-token-at-least-32-chars

# MediaMTX source allowlist. Local development uses the host port mapped by Compose.
# Inside the Compose network use http://media-server:8888.
MEDIA_WORKER_MEDIAMTX_BASE_URL=http://localhost:8898

# HTTP limits
MEDIA_WORKER_MAX_BATCH_SIZE=50
MEDIA_WORKER_MAX_BODY_BYTES=262144

# Job lifecycle. X (thumbnail interval) belongs to Stream Service, not the Worker.
MEDIA_WORKER_JOB_DEADLINE_SECONDS=240
MEDIA_WORKER_READ_TOKEN_TTL_SECONDS=300
MEDIA_WORKER_FFMPEG_TIMEOUT_MS=20000
MEDIA_WORKER_UPLOAD_TIMEOUT_MS=10000
MEDIA_WORKER_CALLBACK_TIMEOUT_MS=5000

# BullMQ queue
MEDIA_WORKER_PROCESSOR_ENABLED=false
MEDIA_WORKER_REDIS_CONNECT_TIMEOUT_MS=1000
MEDIA_WORKER_REDIS_COMMAND_TIMEOUT_MS=1000
MEDIA_WORKER_BATCH_TIMEOUT_MS=3000
MEDIA_WORKER_SHUTDOWN_TIMEOUT_MS=45000
MEDIA_WORKER_QUEUE_CONCURRENCY=2
MEDIA_WORKER_MAX_PENDING_JOBS=1000
# Minimum 24 hours (86400 seconds); must also cover the job deadline.
MEDIA_WORKER_JOB_RETENTION_SECONDS=86400
MEDIA_WORKER_QUEUE_PREFIX=media-worker:thumbnail
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# FFmpeg and temporary files (implemented in Step 5)
MEDIA_WORKER_TEMP_DIR=/tmp/media-worker
MEDIA_WORKER_FFMPEG_PATH=ffmpeg
MEDIA_WORKER_FFPROBE_PATH=ffprobe
MEDIA_WORKER_FFMPEG_THREADS=1
MEDIA_WORKER_MAX_JPEG_BYTES=5242880
MEDIA_WORKER_PROCESS_OUTPUT_BYTES=65536
MEDIA_WORKER_TERMINATION_GRACE_MS=1000
MEDIA_WORKER_THUMBNAIL_WIDTH=640
MEDIA_WORKER_THUMBNAIL_HEIGHT=360

# Cleanup (planned in Step 8)
MEDIA_WORKER_CLEANUP_INTERVAL_SECONDS=3600
MEDIA_WORKER_CLEANUP_MIN_AGE_SECONDS=86400

# Cloudflare R2 (Step 6; set all four values together)
MEDIA_WORKER_R2_ENDPOINT=
MEDIA_WORKER_R2_REGION=auto
MEDIA_WORKER_R2_BUCKET=
MEDIA_WORKER_R2_ACCESS_KEY_ID=
MEDIA_WORKER_R2_SECRET_ACCESS_KEY=

# Stream Service callback (Step 7; local origin, without /stream)
STREAM_SERVICE_BASE_URL=http://localhost:8082
STREAM_SERVICE_INTERNAL_TOKEN=
