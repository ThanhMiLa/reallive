# Example credentials for local development only.
# Copy to .env and replace passwords before starting.
# PostgreSQL ports are fixed in docker-compose.yml: 5432 through 5437.
USER_DB_PASSWORD=local_user_password
CHANNEL_DB_PASSWORD=local_channel_password
STREAM_DB_PASSWORD=local_stream_password
PAYMENT_DB_PASSWORD=local_payment_password
VOD_DB_PASSWORD=local_vod_password
NOTIFICATION_DB_PASSWORD=local_notification_password

MONGODB_PORT=27017
MONGODB_ADMIN_PASSWORD=local_mongodb_admin_password
CHAT_DB_PASSWORD=local_chat_password

REDIS_PORT=6379
REDIS_PASSWORD=local_redis_password

# Export these variables to the user-service process; Spring does not load .env automatically.
# JWT_SIGNER_KEY: Base64-encoded PKCS#8 RSA private key, at least 2048 bits.
JWT_SIGNER_KEY=
# Token lifetimes in seconds.
AUTH_ACCESS_TOKEN_TTL=900
AUTH_REFRESH_TOKEN_TTL=2592000
# Use false only for local development over HTTP.
ACCESS_TOKEN_COOKIE_NAME=access_token
ACCESS_TOKEN_MAX_AGE=86400
ACCESS_TOKEN_SECURE=false
ACCESS_TOKEN_HTTP_ONLY=true
ACCESS_TOKEN_SAME_SITE=Lax
ACCESS_TOKEN_PATH=/

REFRESH_TOKEN_COOKIE_NAME=refresh_token
REFRESH_TOKEN_MAX_AGE=86400
REFRESH_TOKEN_SECURE=false
REFRESH_TOKEN_HTTP_ONLY=true
REFRESH_TOKEN_SAME_SITE=Lax
REFRESH_TOKEN_PATH=/api/auth
AUTH_ALLOWED_ORIGINS=http://localhost:5173
