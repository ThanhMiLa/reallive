#POSTGRESQL
USER_DB_PASSWORD=local_user_password
CHANNEL_DB_PASSWORD=local_channel_password
STREAM_DB_PASSWORD=local_stream_password
PAYMENT_DB_PASSWORD=local_payment_password
VOD_DB_PASSWORD=local_vod_password
NOTIFICATION_DB_PASSWORD=local_notification_password

#MONGODB
MONGODB_PORT=27017
MONGODB_ADMIN_PASSWORD=local_mongodb_admin_password
CHAT_DB_PASSWORD=local_chat_password

#REDIS
REDIS_PORT=6379
REDIS_PASSWORD=local_redis_password

#KAFKA
KAFKA_PORT=9092

#MEDIA SERVER (Stream Service runs on the host in the local setup)
STREAM_MEDIA_JWKS_URL=http://host.docker.internal:8082/stream/internal/api/media/jwks
STREAM_MEDIA_CALLBACK_URL=http://host.docker.internal:8082/stream/internal/api/media-events
STREAM_MEDIA_ALLOWED_ORIGINS=http://localhost:5173

# Concurrent viewer presence (disabled until configured)
STREAM_CCU_ENABLED=false
# Viewer callbacks target Stream Service directly.
STREAM_VIEWER_CALLBACK_URL=http://host.docker.internal:8082/stream/internal/api/viewer-events
